== Left-recursive sets and conflicting table cells ==
nullable = {}
E: FIRST={(, id, num} FOLLOW={$, ), +, -}
T: FIRST={(, id, num} FOLLOW={$, ), *, +, -, /}
F: FIRST={(, id, num} FOLLOW={$, ), *, +, -, /}
[E, (]: E -> E + T | E -> E - T | E -> T
[E, id]: E -> E + T | E -> E - T | E -> T
[E, num]: E -> E + T | E -> E - T | E -> T
[T, (]: T -> T * F | T -> T / F | T -> F
[T, id]: T -> T * F | T -> T / F | T -> F
[T, num]: T -> T * F | T -> T / F | T -> F

== Mechanically rewritten grammar ==
E -> T E'
E' -> + T E' | - T E' | epsilon
T -> F T'
T' -> * F T' | / F T' | epsilon
F -> ( E ) | num | id

== Rewritten nullable, FIRST, FOLLOW and FIRST+ ==
nullable = {E', T'}
E: FIRST={(, id, num} FOLLOW={$, )}
E': FIRST={+, -} FOLLOW={$, )}
T: FIRST={(, id, num} FOLLOW={$, ), +, -}
T': FIRST={*, /} FOLLOW={$, ), +, -}
F: FIRST={(, id, num} FOLLOW={$, ), *, +, -, /}
FIRST+(E -> T E') = {(, id, num}
FIRST+(E' -> + T E') = {+}
FIRST+(E' -> - T E') = {-}
FIRST+(E' -> epsilon) = {$, )}
FIRST+(T -> F T') = {(, id, num}
FIRST+(T' -> * F T') = {*}
FIRST+(T' -> / F T') = {/}
FIRST+(T' -> epsilon) = {$, ), +, -}
FIRST+(F -> ( E )) = {(}
FIRST+(F -> num) = {num}
FIRST+(F -> id) = {id}

== Full rewritten LL(1) table (one row per nonterminal) ==
E | (: T E' ; id: T E' ; num: T E'
E' | $: epsilon ; ): epsilon ; +: + T E' ; -: - T E'
T | (: F T' ; id: F T' ; num: F T'
T' | $: epsilon ; ): epsilon ; *: * F T' ; +: epsilon ; -: epsilon ; /: / F T'
F | (: ( E ) ; id: id ; num: num
conflicting cells = 0

== Predictive trace (stack top at left) ==
E $                    | num - num - num * num $   | E -> T E'
T E' $                 | num - num - num * num $   | T -> F T'
F T' E' $              | num - num - num * num $   | F -> num
num T' E' $            | num - num - num * num $   | match num
T' E' $                | - num - num * num $       | T' -> epsilon
E' $                   | - num - num * num $       | E' -> - T E'
- T E' $               | - num - num * num $       | match -
T E' $                 | num - num * num $         | T -> F T'
F T' E' $              | num - num * num $         | F -> num
num T' E' $            | num - num * num $         | match num
T' E' $                | - num * num $             | T' -> epsilon
E' $                   | - num * num $             | E' -> - T E'
- T E' $               | - num * num $             | match -
T E' $                 | num * num $               | T -> F T'
F T' E' $              | num * num $               | F -> num
num T' E' $            | num * num $               | match num
T' E' $                | * num $                   | T' -> * F T'
* F T' E' $            | * num $                   | match *
F T' E' $              | num $                     | F -> num
num T' E' $            | num $                     | match num
T' E' $                | $                         | T' -> epsilon
E' $                   | $                         | E' -> epsilon
$                      | $                         | accept
